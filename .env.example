# Copy to .env and edit. Every value has a sensible default.

# ---- storage ----
OMRAG_DATA_DIR=./data

# ---- qdrant (local docker) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=multimodal_rag

# ---- models (pulled once, then cached locally) ----
TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
IMAGE_MODEL=ViT-B-32
IMAGE_PRETRAINED=laion2b_s34b_b79k
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
WHISPER_MODEL=large-v3
WHISPER_COMPUTE=int8

# ---- ollama (local llm) ----
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1
VISION_MODEL=llava
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
MAX_CONTEXT_TOKENS=6000

# ---- pipeline tuning ----
CHUNK_TOKENS=512
CHUNK_OVERLAP=50
CANDIDATE_K=20
FINAL_K=5
W_DENSE=0.4
W_RERANK=0.5
W_DIVERSITY=0.1
MMR_LAMBDA=0.7
ENABLE_RERANK=1
ENABLE_VISION_DESCRIBE=1
MAX_UPLOAD_MB=200
